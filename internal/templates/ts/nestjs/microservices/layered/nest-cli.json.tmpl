{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/gateway/src",
  "monorepo": true,
  "root": "apps/gateway",
  "compilerOptions": {
    "webpack": false,
    "tsConfigPath": "apps/gateway/tsconfig.json"
  },
  "projects": {
    "gateway": {
      "type": "application",
      "root": "apps/gateway",
      "entryFile": "main",
      "sourceRoot": "apps/gateway/src",
      "compilerOptions": {
        "tsConfigPath": "apps/gateway/tsconfig.json"
      }
    },
    "sample-ms": {
      "type": "application",
      "root": "apps/sample-ms",
      "entryFile": "main",
      "sourceRoot": "apps/sample-ms/src",
      "compilerOptions": {
        "tsConfigPath": "apps/sample-ms/tsconfig.json"
      }
    }
  }
}
