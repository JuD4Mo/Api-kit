package main

import (
	"log"
	"net/http"
	"time"

	"{{.Module}}/internal/item"
	"{{.Module}}/pkg/bootstrap"
)

func logging(next http.Handler) http.Handler {
	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		log.Println(r.Method, r.URL.Path)
		next.ServeHTTP(w, r)
	})
}

func recoverer(next http.Handler) http.Handler {
	return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
		defer func() {
			if err := recover(); err != nil {
				log.Printf("panic: %v", err)
				http.Error(w, "internal server error", http.StatusInternalServerError)
			}
		}()
		next.ServeHTTP(w, r)
	})
}

func main() {
	l := bootstrap.InitLogger()
	db, err := bootstrap.DBConnection()
	if err != nil {
		l.Fatal(err)
	}

	repo := item.NewRepo(l, db)
	svc := item.NewService(l, repo)
	ctrl := item.NewController(svc)

	mux := http.NewServeMux()
	mux.HandleFunc("POST /items", ctrl.Create)
	mux.HandleFunc("GET /items/{id}", ctrl.GetByID)

	var h http.Handler = mux
	h = logging(h)
	h = recoverer(h)

	srv := &http.Server{
		Handler:      h,
		Addr:         ":8000",
		ReadTimeout:  5 * time.Second,
		WriteTimeout: 10 * time.Second,
		IdleTimeout:  60 * time.Second,
	}

	l.Println("server running on :8000")
	if err := srv.ListenAndServe(); err != nil {
		l.Fatal(err)
	}
}
