package main

import (
	"{{.Module}}/internal/item"
	"{{.Module}}/pkg/bootstrap"
	"github.com/joho/godotenv"
	"github.com/labstack/echo/v4"
	"github.com/labstack/echo/v4/middleware"
)

func main() {
	_ = godotenv.Load()

	l := bootstrap.InitLogger()
	db, err := bootstrap.DBConnection()
	if err != nil {
		l.Fatal(err)
	}

	repo := item.NewRepo(l, db)
	svc := item.NewService(l, repo)
	ctrl := item.NewController(svc)

	e := echo.New()
	e.Use(middleware.Logger())
	e.Use(middleware.Recover())

	g := e.Group("/items")
	g.POST("", ctrl.Create)
	g.GET("/:id", ctrl.GetByID)

	l.Println("server running on :8000")
	l.Fatal(e.Start(":8000"))
}
