package main

import (
	"net/http"
	"time"

	"{{.Module}}/internal/item"
	"{{.Module}}/pkg/bootstrap"
	"github.com/go-chi/chi/v5"
	chimw "github.com/go-chi/chi/v5/middleware"
)

func main() {
	l := bootstrap.InitLogger()
	db, err := bootstrap.DBConnection()
	if err != nil {
		l.Fatal(err)
	}

	repo := item.NewRepo(l, db)
	svc := item.NewService(l, repo)
	ctrl := item.NewController(svc)

	r := chi.NewRouter()
	r.Use(chimw.Logger)
	r.Use(chimw.Recoverer)
	r.Use(chimw.RequestID)
	r.Use(chimw.RealIP)

	r.Mount("/items", ctrl.Routes())

	srv := &http.Server{
		Handler:      r,
		Addr:         ":8000",
		ReadTimeout:  5 * time.Second,
		WriteTimeout: 10 * time.Second,
		IdleTimeout:  60 * time.Second,
	}

	l.Println("server running on :8000")
	if err := srv.ListenAndServe(); err != nil {
		l.Fatal(err)
	}
}
